# Copy this file to .env and fill in real values.
# .env is gitignored - never commit your token.

# Hugging Face token (read access is enough) - used to download the gated/rate-limited model
hf=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Model ---
MODEL_REPO=bartowski/Qwen_Qwen3.5-4B-GGUF
MODEL_FILE=Qwen_Qwen3.5-4B-Q4_0.gguf

# --- llama.cpp server ---
LLAMA_PORT=8080
CTX_SIZE=4096
LLAMA_THREADS=4

# --- Firecrawl ---
FIRECRAWL_PORT=3002
# Leave blank to auto-generate on first run (saved into vendor/firecrawl/.env, not overwritten after)
FIRECRAWL_BULL_AUTH_KEY=

# --- Hermes agent ---
# Path to your Hermes agent's own Dockerfile/build context. If it doesn't exist,
# the stack starts without it and tells you so.
HERMES_DIR=./hermes-agent
HERMES_PORT=8000
