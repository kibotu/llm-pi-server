# Copy to .env and fill in your token.

# Hugging Face token (read access) — needed to download the model
hf=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Model (Qwen 3.5 4B, Q4_K_M quantization — good balance for Pi 5)
MODEL_REPO=bartowski/Qwen_Qwen3.5-4B-GGUF
MODEL_FILE=Qwen_Qwen3.5-4B-Q4_K_M.gguf

# Server
LLAMA_PORT=5370
CTX_SIZE=4096
LLAMA_THREADS=4
